---
import { NEGOCIO, whatsappUrl } from '../config/negocio';
---
<section id="contacto" class="border-t border-slate-800 bg-slate-900/30">
  <div class="mx-auto max-w-6xl px-6 py-20">
    <h2 class="text-3xl font-bold">Contacto</h2>
    <div class="mt-8 grid gap-6 sm:grid-cols-3 text-sm">
      <a href={whatsappUrl('Hola, quiero información sobre traslados')} target="_blank" rel="noreferrer"
         class="rounded-xl border border-slate-800 p-6 hover:border-amber-500/50">
        <p class="text-slate-400">WhatsApp</p>
        <p class="mt-1 font-semibold">{NEGOCIO.telefono}</p>
      </a>
      <a href={`mailto:${NEGOCIO.email}`} class="rounded-xl border border-slate-800 p-6 hover:border-amber-500/50">
        <p class="text-slate-400">Email</p>
        <p class="mt-1 font-semibold">{NEGOCIO.email}</p>
      </a>
      <a href={NEGOCIO.instagram} target="_blank" rel="noreferrer"
         class="rounded-xl border border-slate-800 p-6 hover:border-amber-500/50">
        <p class="text-slate-400">Instagram</p>
        <p class="mt-1 font-semibold">Síguenos</p>
      </a>
    </div>
  </div>
</section>