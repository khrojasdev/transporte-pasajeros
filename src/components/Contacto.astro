---
import { NEGOCIO, whatsappUrl } from '../config/negocio';
---
<section id="contacto" class="bg-marino py-20 text-white">
  <div class="mx-auto max-w-6xl px-6">
    <div class="mb-10 text-center">
      <h2 class="text-3xl font-bold sm:text-4xl">Reserva tu viaje</h2>
      <p class="mt-3 text-white/70">Escríbeme y coordinamos. Guarda mi contacto para cuando necesites un viaje a la segura.</p>
    </div>
    <div class="grid gap-6 sm:grid-cols-3">
      <a href={whatsappUrl('Hola Profe, quiero información sobre un traslado')} target="_blank" rel="noreferrer"
         class="rounded-2xl bg-white/5 p-6 text-center ring-1 ring-white/10 transition hover:bg-white/10">
        <p class="text-sm text-white/60">WhatsApp</p>
        <p class="mt-1 font-semibold text-amarillo">{NEGOCIO.telefono}</p>
      </a>
      <a href={NEGOCIO.instagram} target="_blank" rel="noreferrer"
         class="rounded-2xl bg-white/5 p-6 text-center ring-1 ring-white/10 transition hover:bg-white/10">
        <p class="text-sm text-white/60">Instagram</p>
        <p class="mt-1 font-semibold text-amarillo">{NEGOCIO.instagramHandle}</p>
      </a>
      <a href={`mailto:${NEGOCIO.email}`}
         class="rounded-2xl bg-white/5 p-6 text-center ring-1 ring-white/10 transition hover:bg-white/10">
        <p class="text-sm text-white/60">Email</p>
        <p class="mt-1 font-semibold text-amarillo">{NEGOCIO.email}</p>
      </a>
    </div>
  </div>
</section>