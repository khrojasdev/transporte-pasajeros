---
import { NEGOCIO, whatsappUrl } from '../config/negocio';
---
<section id="inicio" class="relative overflow-hidden bg-marino text-white">
  <div class="absolute inset-0 opacity-10"
       style="background-image: radial-gradient(circle at 20% 30%, #F6AE2D 0, transparent 40%), radial-gradient(circle at 80% 70%, #7CB518 0, transparent 40%);">
  </div>
  <div class="relative mx-auto grid max-w-6xl items-center gap-10 px-6 py-20 sm:py-28 lg:grid-cols-[1.2fr_1fr]">
    <div>
      <p class="mb-4 inline-block rounded-full bg-white/10 px-4 py-1 text-sm font-medium text-amarillo">
        {NEGOCIO.zona}
      </p>
      <h1 class="text-4xl font-bold leading-tight sm:text-5xl lg:text-6xl">
        Traslados privados con la seguridad de <span class="text-amarillo">"El Profe"</span>
      </h1>
      <p class="mt-6 max-w-xl text-lg text-white/80">
        Van {NEGOCIO.anioVan} para hasta {NEGOCIO.capacidadPax} pasajeros. Aeropuerto, eventos, conciertos y turismo,
        con la responsabilidad y transparencia de un profesor jubilado. Precio cerrado antes de subir.
      </p>
      <div class="mt-8 flex flex-wrap gap-4">
        <a href="#cotizar" class="rounded-lg bg-naranja px-6 py-3 font-semibold text-white transition hover:bg-naranja/90">
          Cotizar mi traslado
        </a>
        <a href={whatsappUrl('Hola Profe, quiero cotizar un traslado')} target="_blank" rel="noreferrer"
           class="rounded-lg border border-white/30 px-6 py-3 font-semibold transition hover:bg-white/10">
          Escribir por WhatsApp
        </a>
      </div>
      <dl class="mt-12 grid max-w-lg grid-cols-3 gap-6 border-t border-white/15 pt-8 text-sm">
        <div><dt class="text-white/60">Precio</dt><dd class="mt-1 font-semibold">Cerrado, sin sorpresas</dd></div>
        <div><dt class="text-white/60">Capacidad</dt><dd class="mt-1 font-semibold">Hasta {NEGOCIO.capacidadPax} pasajeros</dd></div>
        <div><dt class="text-white/60">Disponibilidad</dt><dd class="mt-1 font-semibold">24/7 con reserva</dd></div>
      </dl>
    </div>

    <div class="flex justify-center">
      <img src="/logo.webp" alt="ValpoTrips" class="w-64 drop-shadow-2xl sm:w-80" />
    </div>
  </div>
</section>