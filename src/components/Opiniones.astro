---
const opiniones = [
  {
    nombre: 'Camila R.',
    texto: 'Tenía un vuelo a las 7 de la mañana y la verdad andaba nerviosa por la hora. Me pasaron a buscar puntualísimos, el auto impecable y llegué al aeropuerto relajada. Los recomiendo cero dudas.',
    servicio: 'Traslado al aeropuerto',
  },
  {
    nombre: 'Rodrigo F.',
    texto: 'Salimos con los amigos a un cumpleaños y ninguno quería quedar de conductor. Nos fueron a buscar, nos esperaron y dejaron a cada uno en su casa. Nos salió súper conveniente dividiendo entre todos.',
    servicio: 'Conductor designado',
  },
  {
    nombre: 'Familia Vergara',
    texto: 'Los contratamos para un paseo por la costa y fue mucho mejor de lo que esperábamos. Súper amable, se notaba que conocía cada lugar y nos fue contando cosas por el camino. Ya quedamos para la próxima.',
    servicio: 'Tour por la región',
  },
];
---
<section id="opiniones" class="mx-auto max-w-6xl px-6 py-20">
  <div class="mb-10 text-center">
    <h2 class="text-3xl font-bold text-marino sm:text-4xl">Lo que dicen los pasajeros</h2>
    <p class="mt-3 text-marino/60">Confianza que se construye viaje a viaje.</p>
  </div>
  <div class="grid gap-6 md:grid-cols-3">
    {opiniones.map((o) => (
      <figure class="flex flex-col rounded-2xl bg-white p-6 shadow-sm ring-1 ring-marino/5">
        <div class="mb-3 text-amarillo">★★★★★</div>
        <blockquote class="flex-1 text-sm text-marino/70">"{o.texto}"</blockquote>
        <figcaption class="mt-4 border-t border-marino/10 pt-4">
          <p class="font-semibold text-marino">{o.nombre}</p>
          <p class="text-xs text-marino/50">{o.servicio}</p>
        </figcaption>
      </figure>
    ))}
  </div>
</section>