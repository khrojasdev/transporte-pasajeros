---
import { NEGOCIO } from '../config/negocio';
const anio = new Date().getFullYear();
---
<footer class="border-t border-slate-800">
  <div class="mx-auto flex max-w-6xl flex-col gap-2 px-6 py-10 text-sm text-slate-500 sm:flex-row sm:justify-between">
    <p>© {anio} {NEGOCIO.nombre}. {NEGOCIO.zona}.</p>
    <p>Transporte privado de pasajeros</p>
  </div>
</footer>