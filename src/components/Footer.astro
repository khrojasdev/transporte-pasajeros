---
import { NEGOCIO } from '../config/negocio';
const anio = new Date().getFullYear();
---
<footer class="bg-marino-oscuro py-10 text-white/60">
  <div class="mx-auto flex max-w-6xl flex-col items-center gap-3 px-6 text-sm sm:flex-row sm:justify-between">
    <div class="flex items-center gap-3">
      <img src="/logo.webp" alt="ValpoTrips" class="h-9 w-9 rounded-full" />
      <span>© {anio} {NEGOCIO.razonSocial}</span>
    </div>
    <p>{NEGOCIO.zona} · Transporte privado de pasajeros</p>
  </div>
</footer>