---
const servicios = [
  {
    titulo: 'Traslados al aeropuerto',
    desc: 'A SCL con puntualidad absoluta y maletera amplia. Tu viaje empieza tranquilo desde la puerta de tu casa.',
    color: 'bg-marino',
  },
  {
    titulo: 'Conductor designado',
    desc: 'Disfruta esa copa extra sin culpas. Te llevo impecable a tu evento y te regreso seguro a casa.',
    color: 'bg-naranja',
  },
  {
    titulo: 'Tours y paseos',
    desc: 'Descubre la región a tu ritmo, sin estrés de GPS ni estacionamiento. Un viaje premium y a tu medida.',
    color: 'bg-verde',
  },
  {
    titulo: 'Retorno seguro nocturno',
    desc: 'Papás, duerman tranquilos. Paso a buscar a sus hijos del carrete y los dejo sanos en la puerta. Hasta 6 amigos dividen la tarifa.',
    color: 'bg-celeste',
  },
];
---
<section id="servicios" class="mx-auto max-w-6xl px-6 py-20">
  <div class="mb-10 text-center">
    <h2 class="text-3xl font-bold text-marino sm:text-4xl">Nuestros servicios</h2>
    <p class="mt-3 text-marino/60">Todos con precio cerrado, van 2026 y el trato de siempre.</p>
  </div>
  <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
    {servicios.map((s) => (
      <article class="overflow-hidden rounded-2xl bg-white shadow-sm ring-1 ring-marino/5 transition hover:-translate-y-1 hover:shadow-md">
        <div class={`h-2 ${s.color}`}></div>
        <div class="p-6">
          <h3 class="font-bold text-marino">{s.titulo}</h3>
          <p class="mt-2 text-sm text-marino/60">{s.desc}</p>
        </div>
      </article>
    ))}
  </div>
</section>