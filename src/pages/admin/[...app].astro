---
import Base from '../../layouts/Base.astro';
import App from '../../admin/App';

export function getStaticPaths() {
  const rutas = [
    undefined, // /admin
    'calculadora',
    'solicitudes',
    'viajes',
    'viaje',
    'vehiculos',
    'conductores',
    'peajes',
    'configuracion',
    'publicaciones',
  ];
  return rutas.map((app) => ({ params: { app } }));
}
---
<Base title="Panel de administración">
  <div class="min-h-screen bg-slate-950 text-slate-100">
    <App client:only="react" />
  </div>
</Base>