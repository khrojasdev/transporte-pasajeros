---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'ValpoTrips — Transporte privado de pasajeros',
  description = 'Traslados privados a aeropuerto, eventos, conciertos y turismo en Valparaíso y Viña del Mar. La seguridad y puntualidad de El Profe, en una van 2026 para hasta 6 pasajeros.',
} = Astro.props;
---
<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:image" content="/logo.webp" />
  <link rel="icon" href="/logo.webp" />
</head>
<body class="text-marino antialiased">
  <slot />
</body>
</html>